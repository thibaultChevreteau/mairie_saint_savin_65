---
import Layout from '../layouts/Layout.astro';
import AnchorNav from '../components/AnchorNav.astro';
import {
	CalendarDays,
	ExternalLink,
	Flower2,
	MapPin,
	Music2,
	Phone,
	Scissors,
	Users,
	Wheat,
} from 'lucide-astro';

const associations = [
	{
		name: 'Comité des fêtes',
		category: 'Animation & Festivités',
		description: 'Organisation des événements conviviaux, des soirées et des festivités du village.',
		contact: 'lemoinedestsavin@gmail.com',
		kind: 'mail',
	},
	{
		name: 'Association de chasse « L’Indépendante »',
		category: 'Nature & Tradition',
		description: 'Gestion cynégétique, régulation de la faune et entretien des espaces naturels communaux.',
		contact: 'Renseignements en mairie',
		kind: 'info',
	},
	{
		name: 'Association culturelle Edelweiss',
		category: 'Culture & Loisirs',
		description: 'Promotion et organisation d’activités culturelles, artistiques et d’animations locales.',
		contact: 'Visiter le site',
		kind: 'link',
		url: 'https://edelweiss-saint-savin.fr/',
	},
	{
		name: 'Association Aïgaberdenc',
		category: 'Langue & Patrimoine',
		description: 'Pratique, valorisation et transmission de la langue et de la culture occitane.',
		contact: 'Visiter le site',
		kind: 'link',
		url: 'https://agaberdenc.ieo-opm.com/',
	},
	{
		name: 'Les amis de l’Orgue Renaissance',
		category: 'Musique & Patrimoine',
		description: 'Valorisation, entretien et rayonnement musical de l’orgue historique de l’abbatiale de Saint-Savin.',
		contact: 'Renseignements en mairie',
		kind: 'info',
	},
];

const prestations = ['Balayage & coloration', 'Évènementiel', 'Soin sur mesure', 'Prestations homme'];

const navLinks = [
	{ id: 'associations', label: 'Associations' },
	{ id: 'services', label: 'Commerces & Services' },
	{ id: 'activites', label: 'Bien-être & Activités' },
];
---

<Layout title="Vie locale : Associations & Services - Mairie de Saint-Savin">
	<main id="contenu">
		<nav class="mx-auto max-w-7xl px-4 py-4 lg:px-8" aria-label="Fil d’Ariane">
			<ol class="flex items-center gap-2 text-sm text-muted-foreground">
				<li><a href="/" class="hover:text-primary">Accueil</a></li>
				<li aria-hidden="true" class="text-muted-foreground/50">/</li>
				<li aria-current="page" class="text-primary">Vie locale</li>
			</ol>
		</nav>

		<section class="mx-auto max-w-7xl px-4 pb-10 pt-6 lg:px-8 lg:pb-14">
			<p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-secondary">
				Ils font vivre notre village
			</p>
			<h1 class="max-w-4xl font-serif text-4xl leading-tight text-primary sm:text-5xl">
				Vie locale : Associations &amp; Services
			</h1>
			<p class="mt-4 max-w-3xl text-base leading-7 text-muted-foreground">
				Découvrez les associations, les commerces ambulants, les producteurs locaux et les activités qui animent Saint-Savin au quotidien.
			</p>
		</section>

		<AnchorNav links={navLinks} />

		<section id="associations" class="scroll-mt-16 bg-white/60 px-4 py-14 lg:px-8 lg:py-20">
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl">
					<h2 class="font-serif text-3xl text-primary sm:text-4xl">Les Associations de Saint-Savin</h2>
					<p class="mt-3 text-base leading-7 text-muted-foreground">
						Retrouvez l’annuaire des associations culturelles, festives et patrimoniales de notre commune.
					</p>
				</div>

				<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						associations.map((association, index) => (
							<article class="flex flex-col rounded-2xl border border-border border-t-4 border-t-secondary bg-card p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
								<div class="flex size-11 items-center justify-center rounded-xl bg-accent text-primary">
									{index === 0 ? (
										<Users class="size-5" aria-hidden="true" />
									) : index === 1 ? (
										<MapPin class="size-5" aria-hidden="true" />
									) : index === 2 ? (
										<Flower2 class="size-5" aria-hidden="true" />
									) : (
										<Music2 class="size-5" aria-hidden="true" />
									)}
								</div>
								<span class="mt-4 inline-flex w-fit rounded-full bg-secondary px-3 py-1.5 text-xs font-bold text-white">
									{association.category}
								</span>
								<h3 class="mt-4 font-serif text-xl leading-6 text-primary">{association.name}</h3>
								<p class="mt-3 flex-1 text-sm leading-6 text-muted-foreground">{association.description}</p>
								<div class="mt-5 border-t border-border pt-4">
									{association.kind === 'mail' ? (
										<a
											href="mailto:lemoinedestsavin@gmail.com"
											class="break-all text-sm font-semibold text-primary underline-offset-4 hover:underline"
										>
											{association.contact}
										</a>
									) : association.kind === 'link' ? (
										<a
											href={association.url}
											target="_blank"
											rel="noreferrer"
											class="inline-flex items-center gap-2 text-sm font-semibold text-primary underline-offset-4 hover:underline"
										>
											{association.contact}
											<ExternalLink class="size-3.5" aria-hidden="true" />
											<span class="sr-only"> (nouvel onglet)</span>
										</a>
									) : (
										<p class="text-sm font-medium text-primary">{association.contact}</p>
									)}
								</div>
							</article>
						))
					}
				</div>

				<aside class="mt-7 rounded-2xl border border-secondary/30 bg-accent p-5 text-sm leading-6 text-primary sm:p-6">
					<strong>Soutien de la commune :</strong> La commune aide les associations domiciliées à Saint-Savin au niveau logistique et prend en charge les assurances « responsabilité civile » de celles-ci.
				</aside>
			</div>
		</section>

		<section id="services" class="scroll-mt-16 px-4 py-14 lg:px-8 lg:py-20">
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl">
					<h2 class="font-serif text-3xl text-primary sm:text-4xl">Commerces &amp; Services de proximité</h2>
					<p class="mt-3 text-base leading-7 text-muted-foreground">
						Producteurs locaux, passages des commerçants ambulants et services au village.
					</p>
				</div>

				<div class="mt-8 grid gap-5 lg:grid-cols-3">
					<article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
						<div class="flex size-12 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
							<Wheat class="size-5" aria-hidden="true" />
						</div>
						<span class="mt-4 inline-flex rounded-full bg-secondary px-3 py-1.5 text-xs font-bold text-white">
							Producteur local · Vente directe
						</span>
						<h3 class="mt-4 font-serif text-2xl text-primary">La Ferme de Piétat</h3>
						<p class="mt-1 text-sm font-medium text-secondary">Vente d’œufs à la ferme · Saint-Savin</p>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">
							Œufs issus de poules élevées en plein air avec une alimentation de céréales en agriculture biologique.
						</p>
						<div class="mt-5 border-t border-border pt-4">
							<h4 class="text-sm font-semibold text-primary">Tarifs</h4>
							<dl class="mt-2 space-y-2 text-sm">
								<div class="flex justify-between gap-4">
									<dt class="text-muted-foreground">Œuf à l’unité</dt>
									<dd class="font-mono font-semibold text-primary">0,45 €</dd>
								</div>
								<div class="flex justify-between gap-4">
									<dt class="text-muted-foreground">
										Boîte de 6 œufs <span class="text-xs">(boîte 0,10 €)</span>
									</dt>
									<dd class="font-mono font-semibold text-primary">2,60 €</dd>
								</div>
								<div class="flex justify-between gap-4">
									<dt class="text-muted-foreground">
										Boîte de 12 œufs <span class="text-xs">(boîte 0,20 €)</span>
									</dt>
									<dd class="font-mono font-semibold text-primary">5,00 €</dd>
								</div>
							</dl>
						</div>
					</article>

					<article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
						<div class="flex size-12 items-center justify-center rounded-xl bg-accent text-primary">
							<MapPin class="size-5" aria-hidden="true" />
						</div>
						<span class="mt-4 inline-flex rounded-full bg-accent px-3 py-1.5 text-xs font-bold text-primary">
							Passage hebdomadaire
						</span>
						<h3 class="mt-4 font-serif text-2xl text-primary">Boucherie Cazenave</h3>
						<p class="mt-1 text-sm font-medium text-secondary">Boucher ambulant · Coarraze</p>
						<div class="mt-5 rounded-xl bg-background p-4">
							<p class="text-[11px] font-bold uppercase tracking-wider text-secondary">Créneau de passage</p>
							<p class="mt-2 text-sm leading-6 text-primary">Tous les mercredis en fin de journée au village.</p>
						</div>
						<div class="mt-5 border-t border-border pt-4">
							<p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Contact &amp; commandes</p>
							<a
								href="tel:+33608826903"
								class="mt-2 inline-flex items-center gap-2 text-base font-semibold text-primary hover:underline"
							>
								<Phone class="size-4" aria-hidden="true" />06 08 82 69 03
							</a>
						</div>
					</article>

					<article class="rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-7">
						<div class="flex size-12 items-center justify-center rounded-xl bg-accent text-primary">
							<Scissors class="size-5" aria-hidden="true" />
						</div>
						<span class="mt-4 inline-flex rounded-full bg-accent px-3 py-1.5 text-xs font-bold text-primary">
							1 mercredi sur 2
						</span>
						<h3 class="mt-4 font-serif text-2xl text-primary">L’Atelier</h3>
						<p class="mt-1 text-sm font-medium text-secondary">Salon de coiffure itinérant · Léa</p>
						<p class="mt-3 text-sm leading-6 text-muted-foreground">
							Le mercredi, une semaine sur deux, de 9h00 à 19h00 dans le village.
						</p>
						<div class="mt-4">
							<p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Prestations</p>
							<div class="mt-2 flex flex-wrap gap-2">
								{
									prestations.map((item) => (
										<span class="rounded-full bg-secondary/10 px-2.5 py-1 text-xs text-primary">{item}</span>
									))
								}
							</div>
						</div>
						<div class="mt-5 border-t border-border pt-4">
							<p class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Prendre rendez-vous</p>
							<p class="mt-2 text-sm leading-6 text-primary">
								Réservation en ligne via Kalendes, téléphone{' '}
								<a href="tel:+33785976274" class="font-semibold underline-offset-4 hover:underline">
									07 85 97 62 74
								</a>{' '}
								ou Instagram{' '}
								<a
									href="https://instagram.com/l_atelier.lea"
									target="_blank"
									rel="noreferrer"
									class="font-semibold underline-offset-4 hover:underline"
								>
									@l_atelier.lea<span class="sr-only"> (nouvel onglet)</span>
								</a>
								.
							</p>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section id="activites" class="scroll-mt-16 bg-white/60 px-4 py-14 lg:px-8 lg:py-20">
			<div class="mx-auto max-w-7xl">
				<div class="max-w-3xl">
					<h2 class="font-serif text-3xl text-primary sm:text-4xl">Bien-être &amp; Activités hebdomadaires</h2>
					<p class="mt-3 text-base leading-7 text-muted-foreground">
						Activités régulières proposées au village pour se maintenir en forme.
					</p>
				</div>

				<aside class="mt-7 rounded-2xl border border-secondary/30 bg-accent p-5 text-sm leading-6 text-primary sm:p-6">
					<strong>Rythme des séances :</strong> Alternance un lundi soir sur deux : une semaine séance de Yoga, la semaine suivante séance de Pilates.
				</aside>

				<div class="mt-6 grid gap-5 md:grid-cols-2">
					<article class="rounded-2xl border border-border border-l-4 border-l-secondary bg-card p-6 shadow-sm sm:p-7">
						<div class="flex items-start gap-4">
							<span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
								<Flower2 class="size-5" aria-hidden="true" />
							</span>
							<div>
								<span class="inline-flex rounded-full bg-secondary px-3 py-1.5 text-xs font-bold text-white">
									Lundi soir (1 sem. / 2)
								</span>
								<h3 class="mt-4 font-serif text-2xl text-primary">Séances de Yoga</h3>
								<p class="mt-2 text-sm text-muted-foreground">
									Animatrice : <strong class="text-primary">Isabelle Morinay</strong>
								</p>
								<a
									href="tel:+33680184502"
									class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
								>
									<Phone class="size-4" aria-hidden="true" />06 80 18 45 02
								</a>
							</div>
						</div>
					</article>

					<article class="rounded-2xl border border-border border-l-4 border-l-secondary bg-card p-6 shadow-sm sm:p-7">
						<div class="flex items-start gap-4">
							<span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
								<CalendarDays class="size-5" aria-hidden="true" />
							</span>
							<div>
								<span class="inline-flex rounded-full bg-secondary px-3 py-1.5 text-xs font-bold text-white">
									Lundi soir (1 sem. / 2, en alternance avec le Yoga)
								</span>
								<h3 class="mt-4 font-serif text-2xl text-primary">Séances de Pilates</h3>
								<p class="mt-2 text-sm text-muted-foreground">
									Animatrice : <strong class="text-primary">Véronique Lautrou</strong>
								</p>
								<a
									href="tel:+33678673444"
									class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
								>
									<Phone class="size-4" aria-hidden="true" />06 78 67 34 44
								</a>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>
</Layout>
