---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import ActualitesHero from '../../components/actualites/ActualitesHero.astro';
import PanneauPocketBanner from '../../components/actualites/PanneauPocketBanner.astro';
import { getCollection } from 'astro:content';
import { getNewsExcerpt } from '../../utils/news';

const allNews = await getCollection('news');
const articles = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Actualités & Vie Municipale - Mairie de Saint-Savin">
	<main>
		<ActualitesHero />
		<section class="mx-auto max-w-7xl px-4 py-12 lg:px-8 lg:py-16">
			<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{
					articles.map((article) => (
						<NewsCard
							slug={article.id}
							date={article.data.date}
							category={article.data.category}
							title={article.data.title}
							text={getNewsExcerpt(article.data.text || article.body || '')}
							image={article.data.image}
						/>
					))
				}
			</div>
			<PanneauPocketBanner />
		</section>
	</main>
</Layout>
