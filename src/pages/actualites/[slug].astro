---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ExternalLink, FileText } from 'lucide-astro';

export async function getStaticPaths() {
	const allNews = await getCollection('news');
	return allNews.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

const { item } = Astro.props;
const { Content } = await render(item);

const formattedDate = item.data.date.toLocaleDateString('fr-FR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const imageUrl = item.data.imageUrl || item.data.image;
---

<Layout title={`${item.data.title} - Mairie de Saint-Savin`}>
	<main>
		<section class="border-b border-border bg-accent/45 px-4 py-8 lg:px-8 lg:py-12">
			<div class="mx-auto max-w-4xl">
				<nav aria-label="Fil d’Ariane" class="flex flex-wrap items-center gap-2 text-xs font-semibold text-primary/60">
					<a href="/" class="hover:text-primary">Accueil</a>
					<span>/</span>
					<a href="/actualites" class="hover:text-primary">Actualités</a>
					<span>/</span>
					<span class="text-primary truncate max-w-[200px] sm:max-w-none">{item.data.title}</span>
				</nav>
				<a href="/actualites" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
					<ArrowLeft class="size-4" /> Retour aux actualités
				</a>
			</div>
		</section>

		<article class="mx-auto max-w-4xl px-4 py-12 lg:px-8 lg:py-16">
			<div class="flex flex-wrap items-center gap-3">
				<span class="rounded-full bg-secondary px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-secondary-foreground">
					{item.data.category}
				</span>
				<time datetime={item.data.date.toISOString()} class="text-sm text-muted-foreground">
					{formattedDate}
				</time>
			</div>

			<h1 class="mt-5 max-w-3xl font-serif text-3xl leading-tight text-primary sm:text-4xl lg:text-5xl">
				{item.data.title}
			</h1>

			{
				imageUrl ? (
					<div class="mt-8 overflow-hidden rounded-2xl border border-border bg-muted">
						<img src={imageUrl} alt={item.data.title} class="w-full max-h-[500px] object-contain mx-auto" />
					</div>
				) : null
			}

			<div class="prose prose-stone mt-10 max-w-2xl text-base leading-8 text-foreground/80 space-y-4">
				<Content />
			</div>

			{
				item.data.documentUrl ? (
					<div class="mt-8">
						<a
							href={item.data.documentUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
						>
							<FileText class="size-4" /> Voir le document joint
						</a>
					</div>
				) : null
			}

			<div class="mt-10 pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
				{
					item.data.link ? (
						<a
							href={item.data.link}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
						>
							Voir cette information sur PanneauPocket
							<ExternalLink class="size-4" />
						</a>
					) : (
						<a
							href="/infos-pratiques#panneau-pocket"
							class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
						>
							Retrouvez aussi cette information sur l'application PanneauPocket
							<ArrowLeft class="size-4 rotate-180" />
						</a>
					)
				}
			</div>
		</article>
	</main>
</Layout>
