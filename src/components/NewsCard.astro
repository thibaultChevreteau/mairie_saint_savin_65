---
import { ArrowRight } from 'lucide-astro';

interface Props {
	slug: string;
	date: Date;
	category: string;
	title: string;
	text: string;
	image?: string;
}

const { slug, date, category, title, text, image } = Astro.props;

const formattedDate = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="group overflow-hidden rounded-xl border border-border bg-card flex flex-col h-full">
	{
		image ? (
			<a href={`/actualites/${slug}`} class="block aspect-[1.8] overflow-hidden bg-muted">
				<img
					src={image}
					alt={title}
					class="size-full object-cover grayscale-[20%] transition duration-500 group-hover:scale-105"
				/>
			</a>
		) : null
	}
	<div class="p-5 flex flex-col flex-1">
		<div class="flex items-center justify-between gap-3">
			<time datetime={date.toISOString()} class="text-xs text-muted-foreground">{formattedDate}</time>
			<span class="rounded-full bg-secondary px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-secondary-foreground">
				{category}
			</span>
		</div>
		<h3 class="mt-4 font-serif text-xl leading-tight text-primary">
			<a href={`/actualites/${slug}`} class="hover:underline">
				{title}
			</a>
		</h3>
		<p class="mt-2 text-sm leading-6 text-muted-foreground flex-1">{text}</p>
		<a href={`/actualites/${slug}`} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
			Lire la suite <ArrowRight class="size-3.5" />
		</a>
	</div>
</article>
