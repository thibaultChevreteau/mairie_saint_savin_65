---
import { Bell } from 'lucide-astro';
---

<section id="panneaupocket" class="scroll-mt-6 border-y border-border bg-card px-4 py-14 lg:px-8 lg:py-20">
	<div class="mx-auto max-w-7xl">
		<div class="mb-8">
			<p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-secondary">Alertes &amp; actualités</p>
			<h2 class="font-serif text-3xl text-primary sm:text-4xl">Rester Informé</h2>
		</div>
		<div class="grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
			<div class="rounded-2xl bg-accent p-6 sm:p-8">
				<Bell class="size-7 text-primary" />
				<h3 class="mt-5 max-w-xl font-serif text-3xl text-primary">
					Suivez l’actualité de la commune en temps réel avec PanneauPocket
				</h3>
				<p class="mt-4 max-w-2xl text-sm leading-6 text-primary/75">
					Téléchargez gratuitement l’application PanneauPocket sur votre smartphone pour recevoir les alertes, arrêtés et informations d’urgence de la Mairie.
				</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a
						href="https://apps.apple.com/fr/app/panneaupocket/id1184850785"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
					>
						App Store
					</a>
					<a
						href="https://play.google.com/store/apps/details?id=com.panneaupocket"
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-full border border-primary/30 px-4 py-2.5 text-sm font-semibold text-primary hover:bg-primary/5 transition-colors"
					>
						Google Play
					</a>
				</div>
			</div>
			<div class="rounded-2xl border border-border bg-background p-6 sm:p-8 flex flex-col justify-between">
				<div>
					<h3 class="font-serif text-2xl text-primary">Consultez les actualités sur notre site</h3>
					<p class="mt-4 text-sm leading-6 text-muted-foreground">
						Retrouvez également les comptes-rendus, événements et articles complets dans notre rubrique Actualités.
					</p>
				</div>
				<div class="mt-6">
					<a
						href="/actualites"
						class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
					>
						Voir les actualités <span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
