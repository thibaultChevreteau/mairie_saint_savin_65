---
import { Volume2 } from 'lucide-astro';

const timings = [
	{ day: 'Jours ouvrables', hours: '8h30 – 12h00 et 14h30 – 19h30' },
	{ day: 'Samedis', hours: '9h00 – 12h00 et 15h00 – 19h00' },
	{ day: 'Dimanches & Jours fériés', hours: '10h00 – 12h00 et 16h00 – 18h00' },
];
---

<section id="nuisances" class="scroll-mt-6 border-y border-border bg-card px-4 py-14 lg:px-8 lg:py-20">
	<div class="mx-auto max-w-7xl">
		<div class="mb-8">
			<p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-secondary">Tranquillité publique</p>
			<h2 class="font-serif text-3xl text-primary sm:text-4xl">Tranquillité &amp; Nuisances Sonores</h2>
		</div>
		<div class="rounded-2xl border border-border bg-background p-6 sm:p-8">
			<div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
				<div class="max-w-xl">
					<Volume2 class="size-7 text-secondary" />
					<h3 class="mt-5 font-serif text-2xl text-primary">Respectons les temps de repos</h3>
					<p class="mt-3 text-sm leading-6 text-muted-foreground">
						Selon l’arrêté préfectoral du 27/12/1990, les tondeuses, tronçonneuses et équipements bruyants sont autorisés aux horaires suivants :
					</p>
				</div>
				<div class="w-full max-w-xl divide-y divide-border rounded-xl border border-border bg-card">
					{
						timings.map(({ day, hours }) => (
							<div class="flex flex-col gap-1 p-4 text-sm sm:flex-row sm:justify-between sm:gap-4">
								<span class="font-semibold text-primary">{day}</span>
								<span class="text-muted-foreground sm:text-right">{hours}</span>
							</div>
						))
					}
				</div>
			</div>
			<p class="mt-7 border-t border-border pt-5 text-sm italic text-muted-foreground">
				Merci de veiller au respect du voisinage pour le bien-être de tous.
			</p>
		</div>
	</div>
</section>
