---
import { Clock3, Menu, Phone, Search } from 'lucide-astro'

const navItems = ['Accueil', 'Actualités', 'Démarches & Infos', 'Documents', 'Patrimoine']
---

<div class="bg-primary px-4 py-2 text-primary-foreground">
	<div class="mx-auto flex max-w-7xl flex-col gap-1 text-xs font-medium tracking-wide sm:flex-row sm:items-center sm:justify-between">
		<a href="tel:+33500000000" class="flex items-center gap-2 hover:underline">
			<Phone class="size-3.5" /> Urgence / astreinte : 05 00 00 00 00
		</a>
		<span class="flex items-center gap-2 text-primary-foreground/80">
			<Clock3 class="size-3.5" /> Mairie ouverte aujourd’hui de 9h à 12h
		</span>
	</div>
</div>

<header class="border-b border-border bg-background">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 lg:px-8">
		<a href="#accueil" class="flex items-center gap-3" aria-label="Mairie de Saint-Savin, accueil">
			<span class="flex size-11 items-center justify-center rounded-full border-2 border-primary text-primary">
				<span class="font-serif text-xl">S</span>
			</span>
			<span>
				<span class="block font-serif text-xl font-semibold leading-none text-primary">Mairie de Saint-Savin</span>
				<span class="mt-1 block text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Patrimoine &amp; Cadre de vie</span>
			</span>
		</a>
		<nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
			{
				navItems.map((item, index) => (
					<a
						href={index === 0 ? '#accueil' : `#${item.toLowerCase().replaceAll(' ', '-')}`}
						class={`text-sm font-medium transition-colors hover:text-primary ${index === 0 ? 'text-primary' : 'text-muted-foreground'}`}
					>
						{item}
					</a>
				))
			}
		</nav>
		<div class="flex items-center gap-2">
			<button
				class="flex size-10 items-center justify-center rounded-full border border-border text-primary transition hover:bg-secondary"
				aria-label="Rechercher"
			>
				<Search class="size-4" />
			</button>
			<button
				class="flex size-10 items-center justify-center rounded-full border border-border text-primary lg:hidden"
				aria-label="Ouvrir le menu"
			>
				<Menu class="size-5" />
			</button>
		</div>
	</div>
	{/* Menu mobile : rendu fermé, sans interactivité — l'island viendra dans une étape dédiée. */}
</header>
