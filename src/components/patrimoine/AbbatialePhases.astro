---
import { Sun, Check, Hammer, Palette } from 'lucide-astro';

const phases = [
	{
		number: '01',
		title: 'SÉCURISATION & MAÇONNERIE',
		text: 'Mise hors d’eau d’urgence, maçonnerie de la tour-lanterne et couverture de l’absidiole nord.',
		status: 'En cours',
		icon: Hammer,
	},
	{
		number: '02',
		title: 'COUVERTURES & VITRAUX',
		text: 'Restauration de l’oculus de la façade ouest, des vitraux de l’absidiole sud et des toitures de la nef.',
		status: 'À venir',
		icon: Sun,
	},
	{
		number: '03',
		title: 'MOBILIER & PEINTURES',
		text: 'Restauration des peintures de la vie de saint Savin, des statues et des trésors liturgiques intérieurs.',
		status: 'À venir',
		icon: Palette,
	},
];
---

<section id="travaux" class="scroll-mt-6 px-4 py-14 lg:px-8 lg:py-20">
	<div class="mx-auto max-w-7xl">
		<div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
			<div>
				<p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-secondary">
					Le journal des travaux
				</p>
				<h2 class="font-serif text-3xl text-primary sm:text-4xl">
					Trois phases pour une renaissance
				</h2>
			</div>
			<span class="text-sm text-muted-foreground">Un chantier pensé dans le temps</span>
		</div>
		<div class="grid gap-5 lg:grid-cols-3">
			{
				phases.map((phase, index) => {
					const IconComponent = phase.icon;
					return (
						<article class="relative rounded-xl border border-border bg-card p-6">
							<div class="flex items-start justify-between">
								<span class="font-serif text-4xl text-accent-foreground/20">
									{phase.number}
								</span>
								<IconComponent class="size-6 text-secondary" />
							</div>
							<div class="mt-8 h-px bg-border">
								<div class={`h-px bg-secondary ${index === 0 ? 'w-full' : 'w-0'}`} />
							</div>
							<p class="mt-6 text-xs font-bold tracking-[0.12em] text-secondary">
								{phase.title}
							</p>
							<h3 class="mt-3 font-serif text-2xl text-primary">Phase {index + 1}</h3>
							<p class="mt-3 text-sm leading-6 text-muted-foreground">{phase.text}</p>
							<span
								class={`mt-6 inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold ${
									index === 0
										? 'bg-secondary text-secondary-foreground'
										: 'bg-muted text-muted-foreground'
								}`}
							>
								{index === 0 && <Check class="size-3.5" />}
								{phase.status}
							</span>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
