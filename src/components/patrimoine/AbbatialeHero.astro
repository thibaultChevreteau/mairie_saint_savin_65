---
import { ExternalLink } from 'lucide-astro';

const donationUrl = 'https://www.fondation-patrimoine.org/les-projets/abbatiale-de-saint-savin-dans-les-hautes-pyrenees/76006';
---

<section class="border-b border-border bg-accent/45 px-4 py-8 lg:px-8 lg:py-12">
	<div class="mx-auto max-w-7xl">
		<nav aria-label="Fil d’Ariane" class="flex items-center gap-2 text-xs font-semibold text-primary/60">
			<a href="/" class="hover:text-primary">Accueil</a>
			<span>/</span>
			<a href="#projet" class="hover:text-primary">Patrimoine</a>
			<span>/</span>
			<span class="text-primary">Rénovation de l’Abbatiale</span>
		</nav>
		<div class="mt-10 grid items-end gap-8 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<p class="mb-4 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-secondary">
					<span class="h-px w-8 bg-secondary"></span> Projet de sauvegarde
				</p>
				<h1 class="max-w-3xl font-serif text-4xl leading-[1.04] text-primary sm:text-5xl lg:text-6xl">
					Restauration de l’Abbatiale de Saint-Savin
				</h1>
				<p class="mt-6 max-w-2xl text-lg leading-8 text-primary/75">
					Soutenez la préservation d’un joyau roman du XIIe siècle au cœur des Hautes-Pyrénées.
				</p>
				<a
					href={donationUrl}
					target="_blank"
					rel="noreferrer"
					class="mt-8 inline-flex w-fit items-center justify-center gap-2 rounded-full bg-primary px-5 py-3.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90"
				>
					Je donne (Fondation du patrimoine)
					<ExternalLink class="size-4" />
				</a>
			</div>
			<div class="relative aspect-[1.4] overflow-hidden rounded-2xl border border-primary/10 shadow-sm">
				<img
					src="/images/abbaye_saint-savin.jpg"
					alt="Abbatiale de Saint-Savin dans son village"
					class="size-full object-cover"
				/>
				<div class="absolute inset-x-0 bottom-0 bg-primary/85 p-4 text-sm font-semibold text-primary-foreground">
					Un patrimoine vivant, transmis depuis près de 900 ans
				</div>
			</div>
		</div>
	</div>
</section>
