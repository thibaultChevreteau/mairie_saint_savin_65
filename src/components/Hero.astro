---
import { ArrowRight } from 'lucide-astro';
---

<section class="mx-auto max-w-7xl px-4 pb-12 pt-8 lg:px-8 lg:pb-16 lg:pt-12">
	<div class="grid overflow-hidden rounded-2xl bg-accent md:grid-cols-[1.05fr_0.95fr]">
		<div class="flex flex-col justify-center px-6 py-10 sm:px-10 lg:px-16 lg:py-16">
			<span class="mb-5 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-primary">
				<span class="h-px w-8 bg-secondary"></span> Projet patrimoine
			</span>
			<h1 class="max-w-xl font-serif text-4xl leading-[1.08] text-primary sm:text-5xl lg:text-[3.65rem]">
				Soutenez la rénovation de l’Abbaye de Saint-Savin
			</h1>
			<p class="mt-6 max-w-lg text-base leading-7 text-primary/75">
				Un joyau de notre village à préserver ensemble. Découvrez le projet de restauration et participez à la campagne de financement.
			</p>
			<a
				href="/patrimoine/renovation-abbatiale"
				class="mt-8 inline-flex w-fit items-center gap-3 rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90"
			>
				Découvrir le projet et faire un don
				<ArrowRight class="size-4" />
			</a>
		</div>
		<div class="relative min-h-72 overflow-hidden md:min-h-full">
			<img
				src="/images/abbaye_saint-savin.jpg"
				alt="Abbaye historique de Saint-Savin au matin"
				class="absolute inset-0 size-full object-cover"
			/>
			<div class="absolute inset-0 bg-primary/10"></div>
		</div>
	</div>
</section>
