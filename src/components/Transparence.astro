---
import { ArrowRight, Download, FileText } from 'lucide-astro';

const documents = [
	['Compte-rendu du Conseil Municipal - Juillet 2026', '12.08.2026', '842 Ko'],
	['Bulletin Municipal n°42 - Été 2026', '28.07.2026', '3,2 Mo'],
	['Arrêté municipal n°2026-18', '21.07.2026', '156 Ko'],
	['Procès-verbal du Conseil Municipal - Juin 2026', '04.07.2026', '918 Ko'],
];
---

<section id="documents" class="bg-primary px-4 py-14 text-primary-foreground lg:px-8 lg:py-20" aria-labelledby="documents-title">
	<div class="mx-auto max-w-7xl">
		<div class="mb-8 flex items-end justify-between gap-4">
			<div>
				<p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-accent">Transparence municipale</p>
				<h2 id="documents-title" class="font-serif text-3xl sm:text-4xl">
					Dernières délibérations<br class="hidden sm:block" /> &amp; bulletins municipaux
				</h2>
			</div>
			<FileText class="hidden size-10 text-accent/70 sm:block" />
		</div>
		<div class="divide-y divide-primary-foreground/15 rounded-xl border border-primary-foreground/15">
			{
				documents.map(([title, date, size]) => (
					<div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
						<div class="flex items-start gap-4">
							<span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent text-primary">
								<FileText class="size-5" />
							</span>
							<div>
								<h3 class="text-sm font-semibold sm:text-base">{title}</h3>
								<p class="mt-1 text-xs text-primary-foreground/60">Publié le {date} · {size}</p>
							</div>
						</div>
						<a href="#documents" class="inline-flex items-center gap-2 pl-14 text-xs font-bold uppercase tracking-wide text-accent hover:underline sm:pl-0">
							Télécharger (PDF) <Download class="size-4" />
						</a>
					</div>
				))
			}
		</div>
		<a href="#documents" class="mt-7 inline-flex items-center gap-2 rounded-full border border-accent/50 px-5 py-3 text-sm font-semibold text-accent transition hover:bg-accent hover:text-primary">
			Accéder à l’archivage complet des documents <ArrowRight class="size-4" />
		</a>
	</div>
</section>
